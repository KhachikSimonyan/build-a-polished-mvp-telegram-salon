TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
BASE_URL=https://your-public-host-url.example.com
PORT=3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salon_booking

# Optional: Telegram chat id that receives owner/admin booking notifications and /admin access.
OWNER_CHAT_ID=

# Simple demo admin password for /admin.
ADMIN_PASSWORD=123456

# Optional Google Sheets admin sync.
# Share the Google Sheet with the service account email, then paste the Sheet ID here.
GOOGLE_SYNC_ENABLED=false
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# Use this on hosting instead of GOOGLE_SERVICE_ACCOUNT_FILE.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SYNC_INTERVAL_SECONDS=60
